FROM python:3.12-slim

# postgresql-client (pg_dump) and gnupg for backup-cron-r2.
# Using Debian Bookworm's native postgresql-client (PG15) — avoids PGDG repo
# entirely and the libpq5/libldap dependency issues that appeared with PG18.
# pg_dump 15 is compatible with Railway's Postgres for backup purposes.
RUN apt-get update -q \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

# Start command is set per-service in Railway UI Settings → Deploy → Start Command.
# e.g. python scripts/backup_to_r2.py && python scripts/prune_old_backups.py
CMD ["true"]
